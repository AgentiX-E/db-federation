{
  "name": "@agentix-e/db-federation-adapter",
  "version": "0.1.0",
  "description": "db-operations adapters for db-federation engine (health, metrics, audit, tracing)",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentix-e/db-operations-core": "file:../../../db-operations/packages/core",
    "@agentix-e/db-operations-health": "file:../../../db-operations/packages/health",
    "@agentix-e/db-operations-metrics": "file:../../../db-operations/packages/metrics",
    "@agentix-e/db-operations-audit": "file:../../../db-operations/packages/audit",
    "@agentix-e/db-operations-observability": "file:../../../db-operations/packages/observability"
  },
  "devDependencies": {
    "@agentix-e/db-federation": "file:../../..",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8",
    "@types/node": "^22.13.4"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}

{
  "name": "@agentix-e/db-federation",
  "version": "0.1.0",
  "description": "Database federation layer for AgentiX-E",
  "type": "module",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "docs": "typedoc"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zeromq": "^6.2.1",
    "lmdb": "^3.2.6"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.8",
    "@types/node": "^22.13.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentiX-E/db-federation.git"
  },
  "keywords": [
    "database",
    "federation",
    "cdc",
    "replication",
    "multi-datacenter",
    "conflict-resolution"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
